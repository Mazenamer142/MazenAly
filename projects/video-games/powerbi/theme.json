        "dropShadow": [
          {
            "show": true,
            "preset": "Custom",
            "color": {
              "solid": {
                "color": "#0c2340"
              }
            },
            "transparency": 0,
            "shadowBlur": 0,
            "shadowDistance": 4,
            "angle": 45
          }
        ],
        "labels": [
          {
            "color": {
              "solid": {
                "color": "#0c2340"
              }
            },
            "fontSize": 26,
            "fontFamily": "Segoe UI Semibold"
