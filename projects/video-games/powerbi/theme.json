{
  "name": "Portfolio sky",
  "dataColors": [
    "#1f6fd0",
    "#d1571a",
    "#7a4fc4",
    "#0f8f7a",
    "#5d7391",
    "#aebbcd",
    "#ffc83d",
    "#3f9d3a"
  ],
  "background": "#ffffff",
  "foreground": "#0c2340",
  "foregroundNeutralSecondary": "#3a5170",
  "foregroundNeutralTertiary": "#6b83a1",
  "backgroundLight": "#d6e8f9",
  "backgroundNeutral": "#eaf3fc",
  "tableAccent": "#1f6fd0",
  "good": "#0f8f7a",
  "neutral": "#ffc83d",
  "bad": "#d1571a",
  "maximum": "#1f6fd0",
  "center": "#aebbcd",
  "minimum": "#eaf3fc",
  "null": "#d6e8f9",
  "hyperlink": "#0b63c4",
  "textClasses": {
    "callout": {
      "fontSize": 26,
      "fontFace": "Segoe UI Semibold",
      "color": "#0c2340"
    },
    "title": {
      "fontSize": 13,
      "fontFace": "Segoe UI Semibold",
      "color": "#0c2340"
    },
    "header": {
      "fontSize": 12,
      "fontFace": "Segoe UI Semibold",
      "color": "#0c2340"
    },
    "label": {
      "fontSize": 10,
      "fontFace": "Segoe UI",
      "color": "#3a5170"
    }
  },
  "visualStyles": {
    "*": {
      "*": {
        "background": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#ffffff"
              }
            },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#c8dcf0"
              }
            },
            "radius": 14
          }
        ],
        "dropShadow": [
          {
            "show": true,
            "preset": "Custom",
            "color": {
              "solid": {
                "color": "#bcd2eb"
              }
            },
            "transparency": 0,
            "shadowBlur": 0,
            "shadowDistance": 4,
            "angle": 45
          }
        ],
        "title": [
          {
            "show": true,
            "fontColor": {
              "solid": {
                "color": "#0c2340"
              }
            },
            "fontSize": 13,
            "fontFamily": "Segoe UI Semibold",
            "alignment": "left"
          }
        ],
        "subTitle": [
          {
            "fontColor": {
              "solid": {
                "color": "#3a5170"
              }
            },
            "fontSize": 10
          }
        ],
        "visualHeader": [
          {
            "show": false
          }
        ],
        "padding": [
          {
            "top": 8,
            "bottom": 8,
            "left": 10,
            "right": 10
          }
        ],
        "valueAxis": [
          {
            "gridlineColor": {
              "solid": {
                "color": "#d6e8f9"
              }
